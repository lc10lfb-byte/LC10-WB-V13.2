RunService.Heartbeat:Connect(function()
    fpsCounter.frames = fpsCounter.frames + 1
    local now = tick()
    if now - fpsCounter.lastUpdate >= 1 then
        fpsCounter.value = math.floor(fpsCounter.frames / (now - fpsCounter.lastUpdate))
        fpsCounter.frames = 0
        fpsCounter.lastUpdate = now
    end
    cachedMyPos = Camera.CFrame.Position
    cachedPlayers = Players:GetPlayers()
    local ch = LP.Character
    local equipped = ch and ch:FindFirstChildOfClass("Tool")
    if not equipped then isZooming = false
    else isZooming = (BASE_FOV - Camera.FieldOfView) > 10 end

    if C.AntiFling and not hidden and ch then
        local root = ch:FindFirstChild("HumanoidRootPart")
        if root and root.Velocity.Magnitude > 500 then
            root.Velocity = Vector3.zero root.RotVelocity = Vector3.zero
        end
    end

    if hidden or streamHidden then
        if fovC.Visible then fovC.Visible = false end
        if aFovC.Visible then aFovC.Visible = false end
        if sFovC.Visible then sFovC.Visible = false end
    else
        local shouldShowFov = C.ShowFov
        if fovC.Visible ~= shouldShowFov then fovC.Visible = shouldShowFov end
        if shouldShowFov then
            fovC.Size = UDim2.new(0, C.FovRadius*2, 0, C.FovRadius*2)
            fovS.Color = C.FovColor
        end
        local shouldShowAimFov = C.ShowAimbotFov and C.Aimbot
        if aFovC.Visible ~= shouldShowAimFov then aFovC.Visible = shouldShowAimFov end
        if shouldShowAimFov then
            aFovC.Size = UDim2.new(0, C.AimbotFov*2, 0, C.AimbotFov*2)
            aFovS.Color = C.AimbotFovColor
