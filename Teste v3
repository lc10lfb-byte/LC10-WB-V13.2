function processWeapons()
    local char = LP.Character
    if not char then return end
    local containers = { char, LP:FindFirstChild("Backpack") }
    local useGlass = C.Custom_Vidrom
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetDescendants()) do
                if item:IsA("Model") or item:IsA("Tool") then
                    local n = item.Name
                    local anyActive = false
                    local weaponType = "rifle"
                    if isBufalo(n) then weaponType = "bufalo"
                    elseif isPistol(n) then weaponType = "pistol" end
                    if weaponType == "bufalo" and C.Custom_BufaloEnabled then
                        applyWeaponCustomization(item, COLOR_MAP[C.Custom_BufaloColor] or COLOR_MAP.Vermelho, useGlass)
                        anyActive = true
                    elseif weaponType == "pistol" and C.Custom_PistolEnabled then
                        applyWeaponCustomization(item, COLOR_MAP[C.Custom_PistolColor] or COLOR_MAP.Vermelho, useGlass)
                        anyActive = true
                    elseif weaponType == "rifle" and C.Custom_RifleEnabled then
                        applyWeaponCustomization(item, COLOR_MAP[C.Custom_RifleColor] or COLOR_MAP.Vermelho, useGlass)
                        anyActive = true
                    end
                    if C.Custom_Vidrom and not anyActive then
                        for _, d in ipairs(item:GetDescendants()) do
                            if d:IsA("BasePart") or d:IsA("MeshPart") then
                                if not originalWeaponState[d] then
                                    originalWeaponState[d] = { Color = d.Color, Material = d.Material, Transparency = d.Transparency }
                                end
                                d.Material = Enum.Material.Glass
                                d.Transparency = 0.35
                            end
                        end
                    end
                    if weaponType == "pistol" or weaponType == "rifle" then
                        local targetId, targetVol = resolveSoundId(weaponType)
                        for _, s in ipairs(item:GetDescendants()) do
                            if s:IsA("Sound") and isFireSound(s) then
                                if not processedSounds[s] then processedSounds[s] = s.SoundId end
                                if targetId then
                                    if s.SoundId ~= targetId then
                                        s.SoundId = targetId
                                        s.Volume = targetVol
                                    end
                                else
                                    if s.SoundId ~= processedSounds[s] then
                                        s.SoundId = processedSounds[s]
                                        s.Volume = 0.5
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

