local cachedMyPos = Vector3.zero
local cachedPlayers = {}

function isAlive(p)
    local ch = p.Character
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
function sameTeam(a, b)
    return a and b and a.Team and b.Team and a.Team == b.Team
end

function isCivilTeamName(tn)
    local cached = civilTeamCache[tn]
    if cached ~= nil then return cached end
    local result = tn:find("civil") ~= nil
                or tn:find("civilian") ~= nil
                or tn:find("citizen") ~= nil
                or tn == "civ"
    civilTeamCache[tn] = result
    return result
end
function isCivil(plr)
    if not plr then return false end
    local team = plr.Team
    if not team or not team.Name then return false end
    return isCivilTeamName(team.Name:lower())
end

function inFov(pos, radius)
    local screen, on = Camera:WorldToViewportPoint(pos)
    if not on then return false end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    return (Vector2.new(screen.X, screen.Y) - center).Magnitude <= (radius or C.FovRadius)
end
function canSee(targetPart)
    if not C.WallCheck then return true end
    local origin = cachedMyPos
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    local hit = result.Instance
    if hit and targetPart.Parent and hit:IsDescendantOf(targetPart.Parent) then return true end
    return false
end

-- PIXEL AIM (grade 3x3x3)
function getVisiblePixel(plr)
    if not plr then return nil end
    local ch = plr.Character
    if not ch then return nil end

    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    local origin = cachedMyPos

    local PARTS = {
        { name = "Head",          prio = 1 },
        { name = "UpperTorso",    prio = 2 },
        { name = "LowerTorso",    prio = 3 },
        { name = "LeftUpperArm",  prio = 4 },
        { name = "RightUpperArm", prio = 4 },
        { name = "LeftLowerArm",  prio = 5 },
        { name = "RightLowerArm", prio = 5 },
        { name = "LeftHand",      prio = 6 },
        { name = "RightHand",     prio = 6 },
        { name = "LeftUpperLeg",  prio = 5 },
        { name = "RightUpperLeg", prio = 5 },
        { name = "LeftLowerLeg",  prio = 6 },
        { name = "RightLowerLeg", prio = 6 },
        { name = "LeftFoot",      prio = 7 },
        { name = "RightFoot",     prio = 7 },
    }
    local PARTS_R6 = {
        { name = "Head",      prio = 1 },
        { name = "Torso",     prio = 2 },
        { name = "Left Arm",  prio = 4 },
        { name = "Right Arm", prio = 4 },
        { name = "Left Leg",  prio = 5 },
        { name = "Right Leg", prio = 5 },
    }
    if ch:FindFirstChild("Torso") and not ch:FindFirstChild("UpperTorso") then
        PARTS = PARTS_R6
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }

    local best, bestScore = nil, math.huge

    for _, pInfo in ipairs(PARTS) do
        local part = ch:FindFirstChild(pInfo.name)
        if part and part:IsA("BasePart") then
            for ix = -1, 1 do
                for iy = -1, 1 do
                    for iz = -1, 1 do
                        local localPos = Vector3.new(ix, iy, iz) * 0.45 * part.Size
                        local worldPos = part.CFrame:PointToWorldSpace(localPos)

                        local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
                        if onScreen then
                            local dir = worldPos - origin
                            local hit = workspace:Raycast(origin, dir, params)
                            if hit and hit.Instance and hit.Instance:IsDescendantOf(ch) then
                                local distCross = (Vector2.new(sp.X, sp.Y) - Vector2.new(cx, cy)).Magnitude
                                local score = distCross + (pInfo.prio * 30)
                                if score < bestScore then
                                    bestScore = score
                                    best = worldPos
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

function pickTarget(partName, radius, teamCheck, priorityList, ignoreList, checkCivil, usePixel)
    if #cachedPlayers < 2 then return nil end
    local best, bestScore = nil, math.huge
    local origin = cachedMyPos
    for _, plr in ipairs(cachedPlayers) do
        if plr ~= LP and isAlive(plr) then
            if ignoreList and ignoreList[plr.UserId] then continue end
            if checkCivil and isCivil(plr) then continue end
            local ch = plr.Character
            local part = ch:FindFirstChild(partName or "Head") or ch:FindFirstChild("Head")
            if part then
                if teamCheck and sameTeam(LP, plr) then continue end
                if not inFov(part.Position, radius) then continue end
                if not canSee(part) then continue end
                local dist = (part.Position - origin).Magnitude
                local score = dist
                if C.AimbotPrioCrosshair then
                    local sp = Camera:WorldToViewportPoint(part.Position)
                    local cx = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    score = (Vector2.new(sp.X, sp.Y) - cx).Magnitude
                end
                if C.PrioLowHP then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    score = hum and hum.Health or score
                end
                if priorityList and priorityList[plr.UserId] then
                    score = score - 1e6
                end
                if score < bestScore then
                    bestScore = score
                    best = { plr = plr, part = part, pos = part.Position }
                end
            end
        end
    end
    if best and usePixel then
        local pixelPos = getVisiblePixel(best.plr)
        if pixelPos then best.pos = pixelPos end
    end
    return best
end

