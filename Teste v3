--=======================  HOOK  =============================
local HOT_METHODS = {
    ScreenPointToRay = true,
    ViewportPointToRay = true,
    Raycast = true,
}
function isHotMethod(m)
    return HOT_METHODS[m] ~= nil or m:find("FindPartOnRay") ~= nil
end

function theNamecall(self, ...)
    local method = getnamecallmethod()
    if not isHotMethod(method) then
        return originalNamecall(self, ...)
    end
    if C.SilentAim and silentRedirectPass and currentTarget then
        if method == "ScreenPointToRay" or method == "ViewportPointToRay" then
            local origin = cachedMyPos
            local dir = (currentTarget.pos - origin).Unit
            return Ray.new(origin, dir * 1000)
        end
        if method == "Raycast" or method:find("FindPartOnRay") then
            local args = {...}
            if args[1] and typeof(args[1]) == "Ray" then
                local origin = args[1].Origin
                local dir = (currentTarget.pos - origin).Unit
                args[1] = Ray.new(origin, dir * 1000)
                return originalNamecall(self, unpack(args))
            end
        end
    end
    return originalNamecall(self, ...)
end

function setHook(on)
    if not pcall(function() return hookmetamethod end) then return end
    if on and not hookActive then
        if not originalNamecall then
            originalNamecall = hookmetamethod(game, "__namecall", theNamecall)
        else
            hookmetamethod(game, "__namecall", theNamecall)
        end
        hookActive = true
    elseif not on and hookActive then
        hookmetamethod(game, "__namecall", originalNamecall)
        hookActive = false
    end
end

function updateHookState()
    local wantsHook = C.SilentAim
    if wantsHook ~= hookActive then
        setHook(wantsHook)
    end
end

--=======================  AIMBOT NORMAL  ====================
function aimbotStep()
    if hidden or streamHidden then return end
    if not C.Aimbot then
        lockedTarget = nil lockedPlr = nil
        return
    end
    if C.Sweat_Enabled then return end

    local trig = false
    if C.AimbotOnlyZoom and isZooming then trig = true end
    if C.AimbotRequireBtn then trig = true end
    if not C.AimbotOnlyZoom and not C.AimbotRequireBtn then trig = true end
    if not trig then
        lockedTarget = nil lockedPlr = nil
        return
    end

    local cx = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    if lockedTarget and lockedPlr then
        local ch = lockedPlr.Character
        local part = ch and ch:FindFirstChild(C.AimbotPart)
        local isIgnored = C.Aimbot_IgnoreList[lockedPlr.UserId]
        local isCivilLocked = C.Aimbot_CheckCivil and isCivil(lockedPlr)
        if not part or not isAlive(lockedPlr) or isIgnored or isCivilLocked then
            lockedTarget = nil lockedPlr = nil
        else
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            local releaseFov = C.AimbotFov * 1.5
            if not on or (Vector2.new(sp.X, sp.Y) - cx).Magnitude > releaseFov then
                lockedTarget = nil lockedPlr = nil
            else
                lockedTarget = { pos = part.Position }
            end
        end
    end

    if not lockedTarget then
        local t = pickTarget(C.AimbotPart, C.AimbotFov, C.AimbotTeamCheck, C.Aimbot_PriorityList, C.Aimbot_IgnoreList, C.Aimbot_CheckCivil, false)
        if t then
            lockedTarget = { pos = t.pos }
            lockedPlr = t.plr
        end
    end

    if not lockedTarget then return end

    local origin = cachedMyPos
    local tgtCF = CFrame.new(origin, lockedTarget.pos)
    if C.AimbotSnap and isZooming then
        Camera.CFrame = tgtCF
    else
        Camera.CFrame = Camera.CFrame:Lerp(tgtCF, C.AimbotSmooth)
    end
end
pcall(function() RunService:UnbindFromRenderStep("FxAimbot") end)
RunService:BindToRenderStep("FxAimbot", 201, aimbotStep)

