function isPistol(name)
    name = name:lower()
    return name:find("pistol") or name:find("jolland") or name:find("glock") or
           name:find("usp") or name:find("deagle") or name:find("revolver") or
           name:find("m1911") or name:find("p250") or name:find("handgun") or
           name:find("sixshooter")
end
function isBufalo(name)
    name = name:lower()
    return name:find("bufalo") or name:find("buffalo")
end
function isFireSound(s)
    local sN = s.Name:lower()
    local match = (sN == "fire" or sN == "shoot" or sN == "shot"
                   or sN:find("fire") or sN:find("shoot") or sN:find("shot"))
    if not match then return false end
    if sN:find("reload") or sN:find("equip") or sN:find("empty") or sN:find("dry") then return false end
    return true
end
function resolveSoundId(weaponType)
    if weaponType == "pistol" then
        if C.Custom_PistolSound then return PISTOL_SOUND_ID, 0.8 end
        if C.Custom_PistolAltSound and C.Custom_PistolAltSound ~= "Nenhum" then
            local id = SOUND_MAP.Pistol[C.Custom_PistolAltSound]
            if id then return id, 0.8 end
        end
    elseif weaponType == "rifle" then
        if C.Custom_RifleSound and C.Custom_RifleSound ~= "Nenhum" then
            local id = SOUND_MAP.Rifle[C.Custom_RifleSound]
            if id then return id, 0.8 end
        end
    end
    return nil, nil
end

function applyWeaponCustomization(weaponModel, targetColor, applyGlass)
