local function hashConfig(t)
    return game:GetService("HttpService"):JSONEncode(t or {})
end

task.spawn(function()
    local HttpService = game:GetService("HttpService")
    local req = request or http_request or (syn and syn.request) or (http and http.request)

    while true do
        task.wait(INTERVAL)
        pcall(function()
            local res
            if req then
                local ok, r = pcall(req, { Url = URL, Method = "GET" })
                res = ok and r and r.Body or nil
            else
                local ok, r = pcall(function() return game:HttpGet(URL) end)
                res = ok and r or nil
            end

            if res then
                local decodeOk, data = pcall(function() return HttpService:JSONDecode(res) end)
                if decodeOk and data then
                    local newHash = hashConfig(data)
                    if newHash ~= lastHash then
                        lastHash = newHash
                        applyConfig(data)
                    end
                end
            end
        end)
    end
end)

