function setHideDefaultHUD(on)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    if on then
        hiddenHUD = {}
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") and not gui.Name:find("LC10") then
                if gui.Enabled then table.insert(hiddenHUD, gui) gui.Enabled = false end
            end
        end
    else
        for _, gui in ipairs(hiddenHUD) do pcall(function() gui.Enabled = true end) end
        hiddenHUD = {}
    end
end
